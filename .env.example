# Copy to .env.local and fill in real values. Never commit secrets.

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Auth (custom cookie sessions — not NextAuth)
# Optional legacy names if referenced by status checks:
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=The Daily Urlist
RESEND_API_KEY=

# Upstash Redis (REST — used by src/lib/redis.ts)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Upstash Vector
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# QStash
QSTASH_TOKEN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI providers
GOOGLE_GEMINI_API_KEY=
GROQ_LLAMA_API_KEY=
OPENROUTER_API_KEY=
HUGGING_FACE_INFERENCE_API_KEY=

# Sentry (REQ-0006) — tunnel via /api/monitoring in next.config
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Server-only. Source maps / CI upload. Rotate if ever pasted into chat.
SENTRY_AUTH_TOKEN=

# PostHog (REQ-0006) — optional; no-op until key is set
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
